{
  "all": true,
  "src": ["src"],
  "include": ["src/**/*.ts", "src/page/*.js", "dist/**/*.js"],
  "exclude": ["src/page/page.js", "dist/page/**"],
  "exclude-after-remap": true,
  "reporter": ["text", "lcov", "json-summary"],
  "check-coverage": true,
  "lines": 90,
  "branches": 85,
  "functions": 90
}
