{
  "name": "@cognitap/galactica",
  "version": "0.0.0",
  "private": true,
  "description": "Maps a JavaScript or TypeScript repository for agents and humans",
  "bugs": {
    "url": "https://github.com/cognitap/galactica/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cognitap/galactica.git"
  },
  "bin": {
    "galactica": "./dist/cli.js"
  },
  "files": [
    "LICENSE",
    "CHANGELOG.md",
    "dist",
    "skills"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "rimraf dist && tsc -p tsconfig.build.json && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('src/page', 'dist/page', { recursive: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test tests/*.test.ts",
    "fixtures:update": "node tests/update-fixtures.ts",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "rimraf": "6.1.3",
    "svelte": "5.57.3",
    "typescript": "6.0.3",
    "vue": "3.5.44"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2"
}
