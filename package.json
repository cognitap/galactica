{
  "name": "@cognitap/galactica",
  "version": "0.2.4",
  "description": "Trace JavaScript and TypeScript imports, find the tests a change can affect, and explore the dependency graph offline.",
  "keywords": [
    "agent-skills",
    "cli",
    "codemap",
    "dependency-graph",
    "monorepo",
    "typescript"
  ],
  "homepage": "https://github.com/cognitap/galactica#readme",
  "bugs": {
    "url": "https://github.com/cognitap/galactica/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cognitap/galactica.git"
  },
  "bin": {
    "galactica": "./dist/bin.js"
  },
  "files": [
    "LICENSE",
    "CHANGELOG.md",
    "dist",
    "!dist/**/*.map",
    "schema",
    "skills",
    "npm-shrinkwrap.json"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "node scripts/clean-dist.ts && tsc -p tsconfig.build.json && node scripts/build-page.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:coverage && node scripts/pack-and-test.ts",
    "test:coverage": "pnpm build && node node_modules/c8/bin/c8.js node --test tests/*.test.ts",
    "test:browser": "pnpm build && node --test tests/page.test.ts",
    "test:node": "pnpm build && node scripts/test-node.ts",
    "test:package": "pnpm build && node scripts/pack-and-test.ts",
    "bench": "pnpm --silent build && node scripts/bench.ts",
    "bench:agents": "pnpm --silent build && node bench/agents/run.ts",
    "fixtures:update": "node tests/update-fixtures.ts",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:static": "pnpm shrinkwrap:check && pnpm format:check && pnpm lint && pnpm typecheck",
    "check": "pnpm check:static && pnpm test",
    "release:prepare": "node scripts/prepare-release.ts",
    "shrinkwrap:check": "node scripts/shrinkwrap.ts --check",
    "shrinkwrap:update": "node scripts/shrinkwrap.ts --update",
    "shrinkwrap:sync": "node scripts/shrinkwrap.ts --sync-metadata",
    "version": "node scripts/shrinkwrap.ts --sync-metadata"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0"
  },
  "optionalDependencies": {
    "@marko/compiler": "5.42.18",
    "@mdx-js/mdx": "3.1.1",
    "@vue/compiler-sfc": "3.5.44",
    "marko": "6.4.12",
    "svelte": "5.57.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.1.0"
  },
  "packageManager": "pnpm@12.11.2"
}
